# Domain developer API key (https://developer.domain.com.au) with the Listings Management / Agents & Listings package
DOMAIN_API_KEY=

# Random string. Vercel sends it to /api/refresh as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Set to 1 to preview the UI with built-in sample listings instead of calling Domain
USE_SAMPLE_DATA=
